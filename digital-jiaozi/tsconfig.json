{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"], "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
