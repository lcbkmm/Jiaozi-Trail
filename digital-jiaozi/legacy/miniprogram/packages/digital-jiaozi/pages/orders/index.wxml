<view class="dj-page"><view class="dj-title">我的兑换记录</view><view wx:if="{{error}}" class="dj-error">{{error}}</view><view wx:for="{{items}}" wx:key="id" class="dj-panel"><view class="dj-row"><text>{{item.title}}</text><text class="dj-status">{{item.label}}</text></view><view class="dj-note">{{item.cost}} 积分 · {{item.time}}</view><button class="dj-secondary" data-id="{{item.id}}" bindtap="open">查看详情</button></view><view wx:if="{{!items.length}}" class="dj-empty">暂无兑换记录</view><button wx:if="{{cursor}}" class="dj-secondary" bindtap="more" disabled="{{busy}}">加载更多</button></view>
