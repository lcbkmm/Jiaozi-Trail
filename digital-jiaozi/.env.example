# Copy to .env; demo is OFF unless explicitly enabled. Node >=22.13.
DJ_DEMO=false
DJ_PORT=3307
DJ_PUBLIC_URL=http://127.0.0.1:3307
DJ_DATA_DIR=./var
# Required in production: stable random secrets >=32 chars; no client-side copies.
DJ_MEDIA_SECRET=
DJ_INTERNAL_SECRET=
DJ_DEMO_STAFF_SECRET=
DJ_MEDIA_TTL_SECONDS=900
DJ_ORIGINAL_RETENTION_HOURS=24
DJ_AI_BASE_URL=https://tokenrhythm.studio/v1
DJ_AI_API_KEY=
# User-provided candidate only; use the gateway's actual ID. NOT gateway-tested.
DJ_AI_VISION_MODEL=deepseekv4.1flash-1017
DJ_AI_TIMEOUT_MS=15000
