<view class="dj-page"><view class="dj-title">把记忆，带回家</view><view wx:if="{{overview.demo}}" class="dj-demo">以下为演示商品与库存，不代表已备货。</view><view wx:if="{{error}}" class="dj-error">{{error}}</view><view wx:if="{{overview}}" class="dj-panel">可用 <text class="dj-number">{{overview.availablePoints}}</text><view class="dj-note">累计 {{overview.lifetimePoints}} · 兑换不降级</view></view><button class="dj-secondary" bindtap="orders">查看兑换记录</button><view class="dj-goods"><view wx:for="{{items}}" wx:key="id" class="dj-panel dj-good"><view class="dj-product"><dj-image asset-id="{{item.assetId}}"/></view><view class="dj-subtitle">{{item.title}}</view><view class="dj-status">{{item.cost}} 积分 · 库存 {{item.stock}}</view><view class="dj-note">{{item.demo ? '演示商品' : ''}} · 每活动限兑 {{item.limit}} 件</view><view wx:if="{{item.minimum}}" class="dj-note">纪念资格需累计 {{item.minimum}} 分</view><view wx:if="{{item.reason}}" class="dj-note">{{item.reason}}</view><button data-id="{{item.id}}" bindtap="redeem" disabled="{{busy || !item.canRedeem}}">确认兑换</button></view></view><button class="dj-secondary" bindtap="refresh" disabled="{{busy}}">刷新积分与库存</button></view>
