@import "../../styles/common.wxss";
.dj-card{width:100%;height:0;padding-top:150%;position:relative;background:#F8F4E9;border-radius:12rpx;box-sizing:border-box;overflow:hidden}
.dj-background{position:absolute;inset:0}
.dj-card::after{content:"";position:absolute;inset:2%;border:2rpx solid var(--dj-stage);pointer-events:none}
.dj-card-caption,.dj-card-title{position:absolute;left:10%;width:80%;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dj-card-caption{top:4%;font-size:20rpx;line-height:28rpx}
.dj-card-title{top:7.8%;font-size:30rpx;line-height:40rpx;font-weight:700}
.dj-cell{position:absolute}
.dj-stamp{position:absolute}
.dj-blank{border:2rpx dashed #d4cbbb;box-sizing:border-box;border-radius:50%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#a69a88}
.dj-cell-name{position:absolute;display:block;left:0;width:100%;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dj-card-footer{position:absolute;top:89.7%;width:100%;text-align:center;font-size:18rpx;line-height:24rpx;color:#70685d}
.dj-export{position:fixed;left:-9999px;top:0;width:600px;height:900px}
.dj-stamp-dialog{position:fixed;inset:0;z-index:10;background:rgba(0,0,0,.5);padding:64rpx 40rpx;display:flex;align-items:center;justify-content:center}
.dj-stamp-detail{background:#F8F4E9;border-radius:18rpx;padding:32rpx;width:100%;max-height:85vh;box-sizing:border-box;overflow-y:auto}
.dj-detail-image{height:440rpx;margin-top:24rpx}
