<view class="dj-page"><view class="dj-title">积分明细</view><view wx:if="{{error}}" class="dj-error">{{error}}</view><view wx:if="{{overview}}" class="dj-panel"><view>累计成长 {{overview.lifetimePoints}} · 可用 {{overview.availablePoints}}</view><view class="dj-note">兑换与退款只改变可用积分，不改变成长。</view></view><view class="dj-row"><button class="dj-secondary" data-kind="" bindtap="filter">全部</button><button class="dj-secondary" data-kind="EARN" bindtap="filter">获得</button><button class="dj-secondary" data-kind="SPEND" bindtap="filter">使用</button><button class="dj-secondary" data-kind="REFUND" bindtap="filter">退款</button></view><view class="dj-panel"><view wx:for="{{items}}" wx:key="id" class="dj-divider"><view class="dj-row"><text>{{item.label}}</text><text class="dj-status">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text></view><view class="dj-note">{{item.time}} · {{item.sourceId}}</view></view><view wx:if="{{!items.length}}" class="dj-empty">暂无流水</view></view><button wx:if="{{cursor}}" class="dj-secondary" bindtap="more" disabled="{{busy}}">加载更多</button></view>
