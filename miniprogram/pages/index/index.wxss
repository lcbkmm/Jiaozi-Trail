.page-shell { max-width: 960rpx; margin: 0 auto; padding: 26rpx 36rpx 190rpx; }
.location-row, .location, .section-heading, .option-line, .option-group, .stop-meta, .progress-header { display: flex; align-items: center; justify-content: space-between; }
.location { justify-content: flex-start; font-size: 23rpx; font-weight: 500; }
.location-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; background: #bf764b; border-radius: 50%; box-shadow: 0 0 0 7rpx #f0e6d8; }
.edition { color: #7d867b; font-size: 21rpx; letter-spacing: 2rpx; }
.hero { position: relative; padding: 48rpx 0 38rpx; }
.eyebrow { display: block; font-size: 18rpx; letter-spacing: 3rpx; color: #808b7b; }
.hero-title { margin-top: 20rpx; font-size: 66rpx; line-height: 1.2; font-weight: 600; letter-spacing: 1rpx; }
.title-second { display: block; color: #ba714b; }
.hero-description { display: block; margin-top: 23rpx; color: #7a8175; font-size: 24rpx; line-height: 1.7; }
.hero-seal { position: absolute; right: 12rpx; top: 102rpx; padding: 15rpx 12rpx; color: #b77554; border: 2rpx solid #bd8162; border-radius: 7rpx; transform: rotate(8deg); font-size: 22rpx; line-height: 1.35; letter-spacing: 3rpx; opacity: .75; }
.hero-seal text { display: block; }
.ticket-banner { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 230rpx; padding: 31rpx 30rpx; overflow: hidden; border-radius: 18rpx; background: #e9eddf; }
.ticket-copy { position: relative; z-index: 1; }
.ticket-kicker { display: block; color: #65775b; font-size: 20rpx; letter-spacing: 2rpx; }
.ticket-title { display: block; margin-top: 15rpx; color: #304e3e; font-weight: 600; font-size: 29rpx; }
.ticket-caption { display: block; color: #748268; margin-top: 16rpx; font-size: 20rpx; }
.paper-ticket { position: relative; width: 145rpx; height: 180rpx; flex-shrink: 0; margin-right: 2rpx; border: 1rpx solid #cbbe98; outline: 5rpx solid #eee3c4; background: #f4e9cd; color: #526c50; transform: rotate(12deg); text-align: center; box-shadow: 6rpx 10rpx 15rpx #54614218; }
.ticket-top, .ticket-bottom { display: block; font-size: 15rpx; letter-spacing: 3rpx; padding: 11rpx 0; }
.ticket-character { display: block; width: 86rpx; height: 89rpx; margin: 0 auto; border: 1rpx solid #a5a685; border-radius: 50%; font-family: serif; font-size: 65rpx; line-height: 84rpx; }
.ticket-bottom { border-top: 1rpx dashed #c4bc9d; margin-top: 4rpx; font-size: 12rpx; }
.ticket-punch { position: absolute; left: 70%; height: 26rpx; width: 26rpx; border-radius: 50%; background: #f7f5ef; }
.punch-top { top: -13rpx; }.punch-bottom { bottom: -13rpx; }
.section-heading { margin: 44rpx 0 23rpx; gap: 10rpx; }
.section-title { display: block; font-size: 31rpx; font-weight: 600; }
.section-subtitle { display: block; margin-top: 9rpx; font-size: 22rpx; color: #8b9084; line-height: 1.5; }
.section-number { flex-shrink: 0; font-size: 17rpx; letter-spacing: 2rpx; color: #9b9e8f; }
.planner-card { background: #fffefa; border: 1rpx solid #e9e8de; border-radius: 24rpx; padding: 28rpx; box-shadow: 0 8rpx 24rpx #39462d04; }
.input-wrap { display: flex; padding: 22rpx; background: #f3f3ec; border-radius: 14rpx; min-height: 130rpx; }
.input-star { color: #728266; margin-right: 15rpx; font-size: 30rpx; }
.wish-input { flex: 1; width: 100%; min-height: 85rpx; font-size: 25rpx; line-height: 1.7; color: #344e40; padding: 0; }
.wish-placeholder { color: #909588; }
.field-label { display: block; margin: 28rpx 0 17rpx; font-size: 23rpx; color: #768071; }
.chip-row { display: flex; gap: 13rpx; margin-bottom: 25rpx; }
.interest-chip { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 16rpx 6rpx; background: #f4f3ed; color: #858979; border: 1rpx solid transparent; border-radius: 10rpx; font-size: 23rpx; white-space: nowrap; }
.interest-chip.selected { background: #edf1e6; color: #496341; border-color: #d9e2ca; }
.chip-sign { font-size: 21rpx; }.option-line { margin-top: 19rpx; }
.option-label { width: 120rpx; flex-shrink: 0; color: #737d70; font-size: 24rpx; white-space: nowrap; }.option-group { flex: 1; min-width: 0; gap: 10rpx; }
.option { flex: 1; width: auto; min-width: 0; padding: 12rpx 6rpx; background: transparent; color: #979b90; font-size: 23rpx; border-radius: 8rpx; white-space: nowrap; }
.option.active { background: #f0eee2; color: #5c674c; font-weight: 600; }
.last-option { margin-bottom: 29rpx; }.primary-button { display: flex; align-items: center; justify-content: space-between; background: #234b3d; color: #fffefa; padding: 25rpx 28rpx; border-radius: 13rpx; font-size: 27rpx; font-weight: 500; letter-spacing: 1rpx; }
.primary-button:active { background: #315d4c; }.button-arrow { font-size: 35rpx; line-height: 1; font-weight: 400; }
.planner-note { display: block; text-align: center; margin-top: 17rpx; font-size: 19rpx; color: #999d90; }
.route-tag { color: #63754e; background: #e7ecdc; padding: 10rpx 16rpx; border-radius: 8rpx; font-size: 21rpx; }
.route-card { border: 1rpx solid #e4e6d9; background: #fffefa; padding: 30rpx 24rpx; border-radius: 20rpx; }
.route-stop { display: flex; gap: 19rpx; }.stop-rail { width: 42rpx; display: flex; flex-direction: column; align-items: center; }
.stop-number { display: block; flex-shrink: 0; text-align: center; line-height: 42rpx; width: 42rpx; height: 42rpx; border-radius: 50%; color: #73816b; border: 1rpx solid #dbe1d3; font-size: 21rpx; }
.stop-number.stamped { background: #355d49; color: white; border-color: #355d49; }.rail-line { width: 2rpx; flex: 1; background: #e2e5d8; margin: 8rpx 0; }
.stop-content { flex: 1; padding: 1rpx 0 30rpx; }.stop-meta { color: #8c927f; font-size: 20rpx; gap: 5rpx; }
.stop-name { display: block; font-weight: 600; font-size: 29rpx; margin: 12rpx 0 8rpx; }.stop-perk { display: block; color: #8f8267; font-size: 22rpx; }
.checkin-button { display: inline-block; background: #edf1e6; color: #45623c; margin-top: 17rpx; padding: 11rpx 19rpx; border-radius: 8rpx; font-size: 22rpx; }.checkin-button.checked { background: #f0f0e9; color: #969c8d; }
.route-disclaimer { display: block; color: #9b9d90; font-size: 19rpx; line-height: 1.6; border-top: 1rpx solid #eeeee4; padding-top: 18rpx; }
.finds-grid { display: flex; gap: 16rpx; }.find-card { flex: 1; min-width: 0; background: transparent; text-align: left; }
.find-art { height: 207rpx; position: relative; overflow: hidden; border-radius: 12rpx; }.peach { background: #eed5c6; color: #9d5f49; }.sage { background: #dbe3d4; color: #5f755e; }.sand { background: #eae1c6; color: #9b8051; }
.art-orbit { position: absolute; width: 160rpx; height: 160rpx; border: 1rpx solid currentColor; border-radius: 50%; opacity: .25; left: 32rpx; top: 19rpx; }
.art-orbit::after { content: ''; position: absolute; inset: 14rpx; border: 1rpx solid currentColor; border-radius: 50%; }.art-symbol { position: absolute; left: 28rpx; top: 23rpx; font-size: 97rpx; font-family: serif; opacity: .85; font-weight: 400; transform: rotate(-7deg); }
.art-caption { position: absolute; left: 16rpx; bottom: 16rpx; font-size: 13rpx; letter-spacing: 1rpx; }.art-corner { position: absolute; right: 13rpx; top: 10rpx; font-size: 24rpx; }
.find-name { display: block; font-size: 23rpx; font-weight: 500; margin: 16rpx 0 7rpx; }.find-category { display: block; font-size: 20rpx; color: #979a8d; }
.footer-note { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #8e9984; padding: 44rpx 0 27rpx; font-size: 20rpx; letter-spacing: 1rpx; }.footer-flower { font-size: 36rpx; color: #a4ac8d; }
.demo-note { text-align: center; color: #a3a497; font-size: 18rpx; line-height: 1.6; margin-top: 20rpx; }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; padding: 14rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fcfbf6; border-top: 1rpx solid #e7e8dc; display: flex; align-items: center; z-index: 10; }
.nav-item { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; gap: 16rpx; background: transparent; color: #9b9f91; padding: 11rpx 0; font-size: 24rpx; }.nav-active { color: #284f3e; font-weight: 600; }
.nav-divider { width: 1rpx; height: 30rpx; background: #e1e3d6; }.explore-icon { width: 29rpx; height: 29rpx; border: 2rpx solid currentColor; border-radius: 50%; display: flex; align-items: center; justify-content: center; }.explore-icon view { width: 9rpx; height: 15rpx; background: currentColor; transform: rotate(35deg); border-radius: 5rpx 1rpx; }
.wallet-icon { border: 1rpx solid currentColor; border-radius: 4rpx; padding: 1rpx 5rpx; font-family: serif; font-size: 22rpx; }.nav-badge { position: absolute; top: 0; right: 36rpx; background: #bb774d; border-radius: 50%; color: white; width: 26rpx; height: 26rpx; font-size: 17rpx; font-weight: 400; line-height: 26rpx; }
.wallet-heading { padding: 28rpx 0 35rpx; }.wallet-title { display: block; font-size: 55rpx; font-weight: 600; margin-top: 20rpx; }
.collectible-card { position: relative; margin: 0 48rpx; padding: 30rpx 25rpx; border-radius: 22rpx; text-align: center; background: #294e3e; color: #e5d6ab; box-shadow: 0 15rpx 35rpx #294e3e20; border: 7rpx solid #dfd3b4; outline: 1rpx solid #c7c8ad; }
.collectible-card::before { content: ''; position: absolute; inset: 13rpx; border: 1rpx solid #c8bb864a; border-radius: 12rpx; pointer-events: none; }.collectible-top { display: block; letter-spacing: 5rpx; font-size: 20rpx; }
.collectible-ring { margin: 30rpx auto 22rpx; border-radius: 50%; border: 1rpx solid #b9b48a; width: 220rpx; height: 220rpx; display: flex; align-items: center; justify-content: center; outline: 1rpx solid #c5b88355; outline-offset: 11rpx; }
.collectible-ring text { font-family: serif; font-size: 150rpx; line-height: 1; }.collectible-level { display: block; font-size: 31rpx; letter-spacing: 8rpx; }.collectible-bottom { display: block; letter-spacing: 3rpx; margin-top: 22rpx; font-size: 18rpx; color: #bdc2a0; }
.progress-card { background: #fffefa; border: 1rpx solid #e5e6db; border-radius: 20rpx; padding: 30rpx; margin-top: 38rpx; }.progress-header .section-title { font-size: 27rpx; }.progress-count { font-size: 23rpx; color: #8c947e; }
.progress-track { height: 9rpx; border-radius: 8rpx; overflow: hidden; background: #e9ebdf; margin-top: 25rpx; }.progress-fill { height: 100%; border-radius: 8rpx; background: #769469; transition: width .3s; }.progress-message { display: block; margin-top: 17rpx; font-size: 22rpx; color: #8b937e; }
.wallet-stats { display: flex; justify-content: space-around; margin-top: 34rpx; padding-top: 24rpx; border-top: 1rpx solid #eeeee4; text-align: center; }.stat-number { display: block; font-size: 38rpx; }.stat-label { display: block; color: #929987; font-size: 20rpx; margin-top: 7rpx; }
.wallet-help { color: #929785; font-size: 23rpx; line-height: 1.8; padding: 30rpx 5rpx; }.help-title { display: block; font-size: 26rpx; font-weight: 500; margin-bottom: 8rpx; color: #637657; }.wallet-explore { margin-bottom: 28rpx; }
@media (max-width: 340px) { .page-shell { padding-left: 24rpx; padding-right: 24rpx; }.ticket-title { font-size: 26rpx; }.ticket-caption { font-size: 18rpx; }.section-number { font-size: 15rpx; }.interest-chip { font-size: 22rpx; } }
