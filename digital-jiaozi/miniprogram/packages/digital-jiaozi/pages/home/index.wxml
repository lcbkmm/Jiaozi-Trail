<view class="dj-page"><view class="dj-title">我的交子</view><view wx:if="{{overview.demo}}" class="dj-demo">演示活动 · 地点与商品素材为示意</view><view wx:if="{{error}}" class="dj-error">{{error}}</view><button wx:if="{{needsClaim}}" loading="{{busy}}" disabled="{{busy}}" bindtap="claim">领取我的地图交子</button><block wx:if="{{overview}}">
<view class="dj-card" style="--dj-stage:{{overview.stageColor}}"><view class="dj-background"><dj-image asset-id="B01" show-label="{{false}}"/></view><view class="dj-card-caption">循交子之迹 · 留一城记忆</view><view class="dj-card-title">{{overview.title}}</view><view wx:for="{{cells}}" wx:key="index" class="dj-cell" style="{{item.style}}" data-index="{{index}}" bindtap="openStamp"><view class="dj-stamp" style="{{item.imageStyle}}"><dj-image wx:if="{{item.stamp}}" asset-id="{{item.stamp.assetId}}" src="{{item.stamp.imageUrl}}" show-label="{{false}}"/><view wx:else class="dj-blank">待收集</view></view><text class="dj-cell-name" style="{{item.nameStyle}}">{{item.name}}</text></view><view class="dj-card-footer"><view>{{overview.stageName}} · {{overview.serial}}</view><view>第 {{page + 1}} 页</view><view>自制章不代表到店认证</view></view></view>
<view class="dj-row"><button class="dj-secondary" data-delta="-1" bindtap="flip" disabled="{{page === 0}}">上一页</button><text>{{page + 1}} / {{pageCount}}</text><button class="dj-secondary" data-delta="1" bindtap="flip" disabled="{{page + 1 === pageCount}}">下一页</button></view>
<view class="dj-panel"><view class="dj-row"><view>累计成长<view class="dj-number">{{overview.lifetimePoints}}</view></view><view>可用积分<view class="dj-number">{{overview.availablePoints}}</view></view></view><progress percent="{{overview.progress}}" activeColor="{{overview.stageColor}}"/><view class="dj-note">{{overview.nextThreshold ? '下一阶段需累计 ' + overview.nextThreshold + ' 分' : '已到达纪念阶段'}}；兑换只扣可用积分。</view><view>数字纪念交子：{{overview.commemorativeUnlocked ? '已解锁' : '累计 600 分解锁'}}</view><view>实体纪念卡：{{overview.physicalCardStatus}}</view></view>
<view class="dj-nav"><button data-page="photo" bindtap="nav">制作照片章</button><button data-page="tasks" bindtap="nav">去完成任务</button><button class="dj-secondary" data-page="rewards" bindtap="nav">积分兑换</button><button class="dj-secondary" data-page="ledger" bindtap="nav">积分明细</button><button class="dj-secondary" data-page="orders" bindtap="nav">兑换记录</button></view>
<view class="dj-panel"><input class="dj-input" value="{{title}}" maxlength="20" bindinput="titleInput" placeholder="交子名称"/><button class="dj-secondary" bindtap="rename" disabled="{{busy}}">保存名称</button><button bindtap="export" disabled="{{busy}}">导出本页纪念图</button><button wx:if="{{exportPath}}" class="dj-secondary" bindtap="save">保存到相册</button></view></block><button class="dj-secondary" bindtap="refresh" disabled="{{busy}}">刷新服务端状态</button><button class="dj-secondary" bindtap="leave">返回宿主</button><canvas type="2d" id="dj-export" class="dj-export"/>
<view wx:if="{{selectedStamp}}" class="dj-stamp-dialog"><view class="dj-stamp-detail"><view class="dj-subtitle dj-safe-text">{{selectedStamp.title}}</view><view class="dj-detail-image" bindtap="previewStamp"><dj-image asset-id="{{selectedStamp.assetId}}" src="{{selectedStamp.imageUrl}}" show-label="{{true}}"/></view><view class="dj-note">点击章图可放大查看</view><button class="dj-secondary" bindtap="closeStamp">关闭</button></view></view></view>
