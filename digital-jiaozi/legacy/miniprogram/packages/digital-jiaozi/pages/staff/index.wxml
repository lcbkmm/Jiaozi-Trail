<view class="dj-page"><view class="dj-title">工作人员核销</view><view wx:if="{{demo}}" class="dj-demo">工作人员演示入口 · 仅 demo-desk 权限，口令由服务端本地配置提供。</view><view wx:if="{{error}}" class="dj-error">{{error}}</view><view wx:if="{{demo && !loggedIn}}" class="dj-panel"><input class="dj-input" password value="{{secret}}" data-field="secret" bindinput="field" placeholder="请输入工作人员演示口令"/><button bindtap="login" disabled="{{busy}}">登录工作人员演示身份</button></view><view class="dj-panel"><button bindtap="scan" disabled="{{busy}}">扫描真实兑换二维码</button><input class="dj-input" value="{{token}}" data-field="token" bindinput="field" placeholder="或粘贴 dj1: 开头的测试码"/><button class="dj-secondary" bindtap="inspect" disabled="{{busy || !token}}">核验，不立即发放</button></view><view wx:if="{{inspection}}" class="dj-panel"><view class="dj-subtitle">{{inspection.title}}</view><view>订单状态 {{inspection.status}}</view><view>兑换点 {{inspection.pointId}}</view><view wx:if="{{inspection.alreadyRedeemed}}" class="dj-error">此订单已领取，请勿重复发放。</view><button wx:else bindtap="verify" disabled="{{busy}}">确认核销并发放</button></view><view wx:if="{{result}}" class="dj-panel"><view class="dj-status">{{result.alreadyRedeemed ? '已核销，请勿重复发放' : '核销成功，请发放对应实物'}}</view><view>{{result.title}}</view><button class="dj-secondary" bindtap="again">继续扫码</button></view></view>
