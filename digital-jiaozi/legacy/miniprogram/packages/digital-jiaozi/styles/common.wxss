page{background:#F8F4E9;color:#2B2926;font-size:28rpx;line-height:1.6}.dj-page{padding:28rpx 32rpx calc(44rpx + env(safe-area-inset-bottom))}.dj-title{font-size:40rpx;font-weight:700;margin:12rpx 0 24rpx}.dj-subtitle{font-size:32rpx;font-weight:600}.dj-panel{padding:28rpx;background:rgba(255,255,255,.72);border:1rpx solid #e4dece;border-radius:18rpx;margin-bottom:24rpx}.dj-note{font-size:24rpx;color:#70685d;margin:14rpx 0}.dj-demo{color:#496C5C;font-size:24rpx;padding:12rpx 18rpx;border-radius:8rpx;background:#e8eee6;margin-bottom:20rpx}.dj-error{color:#B83A32;padding:18rpx;border:1rpx solid #B83A32;border-radius:10rpx;margin:16rpx 0;word-break:break-all}.dj-row{display:flex;gap:20rpx;align-items:center;justify-content:space-between}.dj-stack{display:flex;flex-direction:column}.dj-number{font-size:48rpx;font-weight:700;color:#B83A32}.dj-button,button{min-height:88rpx;font-size:28rpx;border-radius:12rpx;background:#B83A32;color:white;margin:16rpx 0;display:flex;align-items:center;justify-content:center;white-space:normal;line-height:1.5;padding:12rpx 18rpx;box-sizing:border-box}button[disabled]{background:#e8e2d7;color:#827869}.dj-secondary{background:#eee9dd;color:#2B2926}.dj-row>button{flex:1}.dj-input{height:88rpx;border:1rpx solid #d4cbbb;background:white;border-radius:10rpx;padding:0 20rpx;margin:16rpx 0;font-size:28rpx}.dj-tag{font-size:22rpx;color:#496C5C}.dj-divider{border-bottom:1rpx solid #e5dece;padding:20rpx 0}.dj-picture{width:100%;height:340rpx}.dj-empty{padding:50rpx 16rpx;text-align:center;color:#70685d}.dj-status{font-weight:700;color:#496C5C}.dj-nav{display:flex;gap:16rpx;flex-wrap:wrap}.dj-nav>button{min-width:42%;flex:1}.dj-safe-text{word-break:break-all}
