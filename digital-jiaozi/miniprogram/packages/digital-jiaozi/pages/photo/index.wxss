@import "../../styles/common.wxss";
.dj-crop{position:relative;overflow:hidden;background:#ded8cb;margin:0 auto;touch-action:none}.dj-crop-photo{position:absolute;max-width:none}.dj-crop-grid{position:absolute;inset:0;border:2px solid #B83A32;box-sizing:border-box;background:linear-gradient(90deg,transparent 33%,#ffffff55 33%,#ffffff55 33.5%,transparent 33.5%,transparent 66%,#ffffff55 66%,#ffffff55 66.5%,transparent 66.5%);pointer-events:none}.dj-preview{background:#496C5C;border-radius:12rpx;padding:20rpx;text-align:center}.dj-result{width:460rpx;height:460rpx;max-width:100%}
