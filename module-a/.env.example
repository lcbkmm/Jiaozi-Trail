# Local backend configuration; the application reads module-a/.env.local.
# Copy this file to .env.local and keep credentials local.
APP_MODE=demo
DATABASE_PATH=runtime/jiaozi-trail.sqlite3

# Existing gateway/model configuration; actual capabilities still need a probe.
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=deepseek-v4-1-flash-261017
LLM_API_KEY=
LLM_TOP_LOGPROBS=5
LLM_THINKING_PROFILE=deepseek_disabled

# Use baidu after the server AK and required APIs have been verified.
BAIDU_SERVER_AK=
MAPS_MODE=prepared

# sqlite is the default; redis is optional.
NEARBY_PROVIDER=sqlite
REDIS_URL=

# Switch to http after module B has a working endpoint.
JIAOZI_MODE=demo
JIAOZI_BASE_URL=

# Advisory only; enable after the configured model returns complete yes/no logprobs.
JEV_ENABLED=false

# Optional team catalog inputs after mapping to backend Place/CampaignStop schema.
PLACES_PATH=runtime/places.json
CAMPAIGN_PATH=data/campaign.json
