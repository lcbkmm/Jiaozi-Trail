@import "../../styles/common.wxss";
.dj-card{width:100%;height:0;padding-top:66.666667%;position:relative;border-radius:12rpx;box-sizing:border-box;overflow:hidden}.dj-background{position:absolute;inset:0}.dj-card::after{content:"";position:absolute;inset:2%;border:2rpx solid var(--dj-stage);pointer-events:none}.dj-card-title{position:absolute;top:6%;left:10%;width:80%;text-align:center;font-size:30rpx;font-weight:700}.dj-cell{position:absolute;display:flex;flex-direction:column;align-items:center}.dj-stamp{position:absolute;top:0}.dj-blank{border:2rpx dashed #d4cbbb;border-radius:50%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#a69a88}.dj-cell-name{position:absolute;left:0;width:100%;text-align:center;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2}.dj-cell-source{font-size:16rpx;line-height:1.2;color:#70685d}.dj-card-footer{position:absolute;bottom:3%;width:100%;text-align:center;font-size:20rpx;color:#70685d}.dj-export{position:fixed;left:-9999px;top:0;width:600px;height:500px}
